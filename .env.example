# Copy to .env and replace every value. Never commit .env.
POSTGRES_PASSWORD=replace-me-superuser-password
SECUREAI_MIGRATOR_PASSWORD=replace-me-migrator-password
SECUREAI_APP_PASSWORD=replace-me-app-password

SECUREAI_ENV=development
SECUREAI_DB_HOST=127.0.0.1
SECUREAI_DB_PORT=55432
SECUREAI_DB_NAME=secureai
SECUREAI_TEST_DB_NAME=secureai_test
SECUREAI_DB_SSLMODE=prefer
# HMAC key for refresh/reset token hashes. Kept OUT of the database. openssl rand -hex 32
SECUREAI_TOKEN_PEPPER=replace-me-64-hex-chars
# Access-token signing keys "kid:hex[,kid:hex]". FIRST signs, all verify (rotation). openssl rand -hex 32
SECUREAI_JWT_KEYS=k1:replace-me-64-hex-chars
# Frontend origin used in password-reset links (https required in production)
SECUREAI_PUBLIC_URL=http://localhost:5173
# Breached-password check: "hibp" (k-anonymity: only 5 hex chars of SHA-1 leave the server) or "off".
# Defaults to hibp in production, off elsewhere.
SECUREAI_BREACH_CHECK=off
